#!/bin/sh
# SSH: connect to other machines, manage keys, configure the SSH server
. /usr/lib/hs/common.sh
export HOME=/root
D(){ dialog --backtitle "HomeServer OS  |  $(hostname)" --colors "$@"; }
ask(){ "$@" 2>&1 >/dev/tty; }
T=/tmp/hs-ssh.$$; trap 'rm -f $T' EXIT
msg(){ D --title " $1 " --msgbox "\n$2" 10 68; }
KEY=/root/.ssh/id_dropbear; AK=/root/.ssh/authorized_keys; SC=$HS/ssh.conf
pubkey(){ dropbearkey -y -f $KEY 2>/dev/null | grep '^ssh-'; }
connect(){
  t=$(ask D --title " Connect (SSH) " --inputbox "Address of the other computer:\n  user@host      or      user@host:port" 10 62 "root@") || return
  case $t in *@*) ;; *) msg "Connect" "Use the form  user@host"; return;; esac
  port=22; case ${t##*@} in *:*) port=${t##*:}; t=${t%:*};; esac
  clear; printf ' Connecting to %s (port %s)...  Type %sexit%s or press Ctrl-D to come back.\n\n' "$t" "$port" "$(c '1;33')" "$(c 0)"
  dbclient -t -p "$port" "$t"; printf '\n Connection closed. Press Enter to continue.'; read -r _
}
mykey(){
  mkdir -p /root/.ssh; chmod 700 /root/.ssh
  if [ ! -f $KEY ]; then
    D --title " Create a key " --yesno "\nNo SSH key exists on this computer yet.\nCreate one now (ed25519)?" 8 56 || return
    dropbearkey -t ed25519 -f $KEY >/dev/null 2>&1 || { msg "SSH key" "Could not create the key."; return; }
  fi
  { echo "Your public key (add this line to ~/.ssh/authorized_keys on the other computer):"; echo; pubkey; } > $T
  D --title " My public key " --exit-label "Back" --textbox $T 12 78
}
addkey(){
  mkdir -p /root/.ssh; chmod 700 /root/.ssh
  k=$(ask D --title " Allow a key " --inputbox "Paste ONE public key line (starts with ssh-ed25519 or ssh-rsa).\nThis lets its owner log in as root without the password:" 11 78) || return
  case $k in ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *) echo "$k" >> $AK; chmod 600 $AK; msg "Allow a key" "Key added.";; *) msg "Allow a key" "That does not look like a public key.";; esac
}
server(){
  [ -f $SC ] && . $SC; PW=${PASSWORD_AUTH:-on}
  set -- 1 "Password login for root: $PW" 2 "Start / restart the SSH server now" 3 "Stop the SSH server" 4 "Start the SSH server at every boot" 5 "Do not start at boot"
  c=$(ask D --title " SSH server " --cancel-label Back --menu "Status: $(hs-service status ssh).  Address: $(ip -4 -o addr show scope global | awk '{print $4}' | head -n1)  port 22" 15 66 5 "$@") || return
  case $c in
  1) if [ "$PW" = on ]; then echo PASSWORD_AUTH=off > $SC; else echo PASSWORD_AUTH=on > $SC; fi
     [ "$(hs-service status ssh)" = running ] && hs-service restart ssh; msg "SSH server" "Changed. Keys-only login needs a key in authorized_keys first!";;
  2) hs-service restart ssh; msg "SSH server" "SSH server: $(hs-service status ssh)";;
  3) hs-service stop ssh; msg "SSH server" "Stopped.";;
  4) hs-service enable ssh; hs-service start ssh; msg "SSH server" "Enabled at boot and started.";;
  5) hs-service disable ssh; msg "SSH server" "It will not start at boot.";;
  esac
}
while :; do
  c=$(ask D --title " SSH " --cancel-label Back --menu "Secure remote access (Dropbear)." 14 70 5 \
    1 "Connect to another computer" 2 "SSH server (let others log in here)" 3 "My public key (create / show)" 4 "Allow a key to log in here" 5 "Copy a file with scp (help)") || exit 0
  case $c in
  1) connect;; 2) server;; 3) mykey;; 4) addkey;;
  5) printf 'Copy to another computer:   scp file user@host:/path/\nCopy from another computer: scp user@host:/path/file .\nAdd -P PORT for a different port.\n' > $T; D --title " scp " --exit-label Back --textbox $T 9 64;;
  esac
done
