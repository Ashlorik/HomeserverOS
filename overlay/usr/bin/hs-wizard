#!/bin/sh
# First-boot setup wizard
. /usr/lib/hs/common.sh
trap '' INT QUIT TSTP
D(){ dialog --backtitle "HomeServer OS  |  first-boot setup" --colors "$@"; }
ask(){ "$@" 2>&1 >/dev/tty; }
valid_ip(){ echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; }
valid_cidr(){ echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'; }

D --title " Welcome " --ok-label "Start" --msgbox "\nWelcome to \Zb\Z6HomeServer OS\Zn!\n\nThis short wizard will:\n\n   1.  give this server a name\n   2.  set the password for the users admin and root\n   3.  configure the network and remote access\n\nUse the arrow keys, TAB and ENTER to navigate." 15 62 || true

host=homesrv
while :; do
  host=$(ask D --no-cancel --title " Server name " --inputbox "Name of this server on the network.\nLetters, digits and dashes only (max 32):" 10 60 "$host") || continue
  echo "$host" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,30}[A-Za-z0-9])?$' && break
  D --title " Invalid name " --msgbox "\n\"$host\" is not a valid host name." 7 50
done

while :; do
  p1=$(ask D --no-cancel --insecure --title " Password " --passwordbox "Choose a password for the users \"admin\" and \"root\"\n(at least 6 characters):" 10 60) || continue
  p2=$(ask D --no-cancel --insecure --title " Administrator password " --passwordbox "Type the password again to confirm:" 9 60) || continue
  [ "$p1" = "$p2" ] || { D --title " Mismatch " --msgbox "\nThe passwords do not match. Try again." 7 50; continue; }
  [ ${#p1} -ge 6 ] || { D --title " Too short " --msgbox "\nUse at least 6 characters." 7 50; continue; }
  case $p1 in *:*) D --title " Not allowed " --msgbox "\nThe password must not contain a colon (:)." 7 54; continue;; esac
  break
done

MODE=dhcp IFACE=auto ADDR= GW= DNS=
IF1=$(hs-net ifaces | head -n1)
if [ -z "$IF1" ]; then
  D --title " Network " --msgbox "\nNo wired network card was detected.\nYou can configure the network later from the menu." 9 60
else
  m=$(ask D --no-cancel --title " Network " --menu "How should this server get its address?" 12 66 2 \
    dhcp "Automatic (DHCP)  - recommended" static "Manual (static IP address)") || m=dhcp
  if [ "$m" = static ]; then
    while :; do
      out=$(ask D --no-cancel --title " Static network " --form "Fill in the fields (example for a typical home router):" 14 64 4 \
        "Interface:"     1 1 "$IF1"             1 16 16 0 \
        "Address/CIDR:"  2 1 "192.168.1.10/24"  2 16 20 0 \
        "Gateway:"       3 1 "192.168.1.1"      3 16 16 0 \
        "DNS server:"    4 1 "1.1.1.1"          4 16 32 0) || continue
      OLDIFS=$IFS; IFS='
'; set -- $out; IFS=$OLDIFS
      if valid_cidr "$2" && valid_ip "$3" && valid_ip "$4"; then MODE=static IFACE=$1 ADDR=$2 GW=$3 DNS=$4; break; fi
      D --title " Check the values " --msgbox "\nAddress must look like 192.168.1.10/24,\ngateway and DNS like 192.168.1.1." 9 56
    done
  fi
fi

ssh=no
D --title " Remote access " --yes-label "Enable" --no-label "Not now" --yesno "\nAllow remote login over SSH (port 22)?\n\nYou can then manage this server from another computer\nwith the root password. It can be changed later in the menu." 11 62 && ssh=yes

if [ "$MODE" = static ]; then net="Static  $ADDR  via $GW"; else net="Automatic (DHCP)"; fi
D --title " Ready to apply " --yes-label "Apply" --no-label "Redo" --yesno "\n  Server name :  $host\n  Users       :  admin, root (one password)\n  Network     :  $net\n  SSH login   :  $ssh\n\nApply these settings?" 13 62 || exec "$0"

mkdir -p $HS
echo "$host" > $HS/hostname; hostname "$host"
printf 'MODE=%s\nIFACE=%s\nADDR=%s\nGW=%s\nDNS=%s\n' "$MODE" "$IFACE" "$ADDR" "$GW" "$DNS" > $HS/network.conf
[ -f /etc/shadow ] || { echo 'root:*::0:99999:7:::' > /etc/shadow; chmod 600 /etc/shadow; }
printf 'root:%s\nadmin:%s\n' "$p1" "$p1" | chpasswd -c sha512
[ "$ssh" = yes ] && { hs-service enable ssh; hs-service start ssh >/dev/null 2>&1 & }
touch $HS/configured
hs-net apply >/dev/null 2>&1 &
D --title " All set " --ok-label "Continue" --msgbox "\nSetup is complete.\n\nLog in as  \Zb\Z6admin\Zn  with the password you just chose.\nAfter logging in, the menu opens (it asks for the same password\nonce more, because it changes the system)." 12 66
clear
