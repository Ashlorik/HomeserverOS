#!/bin/sh
# HomeServer OS management console
. /usr/lib/hs/common.sh
D(){ dialog --backtitle "HomeServer OS  |  $(hostname)" --colors "$@"; }
ask(){ "$@" 2>&1 >/dev/tty; }
T=/tmp/hs-menu.$$; trap 'rm -f $T $T.*' EXIT
msg(){ D --title " $1 " --msgbox "\n$2" 10 64; }
box(){ D --title " $1 " --exit-label "Back" --textbox "$2" 0 0; }
runbox(){ t=$1; shift; "$@" > $T 2>&1; box "$t" $T; }

# ---------------------------------------------------------------- network
net_menu(){ while :; do
  c=$(ask D --title " Network " --cancel-label "Back" --menu "Connection settings and tools." 11 62 4 \
    1 "Show network status" 2 "Use automatic address (DHCP)" 3 "Set a static IP address" 4 "Test connectivity (ping)") || return
  case $c in
  1) runbox "Network status" hs-net status;;
  2) printf 'MODE=dhcp\nIFACE=auto\nADDR=\nGW=\nDNS=\n' > $HS/network.conf; hs-net apply >/dev/null 2>&1 &
     msg "Network" "Switched to automatic (DHCP). The address appears in a few seconds.";;
  3) IF1=$(hs-net ifaces | head -n1)
     out=$(ask D --title " Static network " --form "Fill in the fields:" 14 64 4 \
       "Interface:" 1 1 "$IF1" 1 16 16 0 "Address/CIDR:" 2 1 "192.168.1.10/24" 2 16 20 0 \
       "Gateway:" 3 1 "192.168.1.1" 3 16 16 0 "DNS server:" 4 1 "1.1.1.1" 4 16 32 0) || continue
     OLDIFS=$IFS; IFS='
'; set -- $out; IFS=$OLDIFS
     if echo "$2" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$' && [ -n "$1" ]; then
       printf 'MODE=static\nIFACE=%s\nADDR=%s\nGW=%s\nDNS=%s\n' "$1" "$2" "$3" "$4" > $HS/network.conf; hs-net apply >/dev/null 2>&1
       msg "Network" "Static address $2 applied."
     else msg "Network" "Address must look like 192.168.1.10/24."; fi;;
  4) h=$(ask D --title " Ping " --inputbox "Host to test:" 8 50 "1.1.1.1") || continue
     ping -c 3 -W 2 "$h" > $T 2>&1; box "Ping $h" $T;;
  esac; done; }

# ---------------------------------------------------------------- storage
parts(){ while read -r maj min blocks name; do
  case $name in ''|name|loop*|ram*) continue;; esac
  [ -b /dev/$name ] || continue
  grep -q "^/dev/$name " /proc/mounts && continue
  fs=$(blkid /dev/$name 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p'); [ -n "$fs" ] || continue
  echo "$name"; echo "$(awk -v b=$blocks 'BEGIN{printf "%.1f GB", b/1048576}')  $fs"; done < /proc/partitions; }
disk_menu(){ while :; do
  c=$(ask D --title " Storage " --cancel-label "Back" --menu "Disks, partitions and USB drives." 10 62 3 \
    1 "Usage overview" 2 "Mount a partition / USB drive" 3 "Unmount a drive") || return
  case $c in
  1) { echo "== Mounted filesystems =="; df -h | awk 'NR==1 || $1 ~ /^\/dev\//'; echo; echo "== Block devices =="
       awk 'NR>2 {printf "%-10s %9.1f GB\n", $4, $3/1048576}' /proc/partitions; } > $T; box "Storage" $T;;
  2) set -- $(parts)
     if [ $# -eq 0 ]; then msg "Mount" "No unmounted partitions with a supported filesystem (ext4, FAT) were found."; continue; fi
     p=$(ask D --title " Mount " --menu "Choose a partition:" 16 62 8 "$@") || continue
     mkdir -p /mnt/$p
     if mount -o noatime /dev/$p /mnt/$p 2> $T; then msg "Mount" "Mounted at /mnt/$p"; else msg "Mount failed" "$(cat $T)"; rmdir /mnt/$p 2>/dev/null; fi;;
  3) set -- $(awk '$2 ~ /^\/mnt\// {print $2; print $1}' /proc/mounts)
     if [ $# -eq 0 ]; then msg "Unmount" "Nothing is mounted under /mnt."; continue; fi
     p=$(ask D --title " Unmount " --menu "Choose a drive:" 14 62 6 "$@") || continue
     if umount "$p" 2> $T; then rmdir "$p" 2>/dev/null; msg "Unmount" "$p unmounted. It is safe to remove the drive."; else msg "Unmount failed" "$(cat $T)"; fi;;
  esac; done; }

# ---------------------------------------------------------------- services
svc_menu(){
  set --; for s in web ssh ntp cron; do
    on=off; hs-service list | grep -q "^$s .*boot:on" && on=on
    set -- "$@" "$s" "$(hs-service desc $s) [$(hs-service status $s)]" "$on"; done
  sel=$(ask D --title " Services " --separate-output --checklist "Tick the services that should run (they start now and at every boot):" 15 76 4 "$@") || return
  for s in web ssh ntp cron; do
    if echo "$sel" | grep -qx "$s"; then hs-service enable $s; hs-service start $s >/dev/null 2>&1
    else hs-service disable $s; hs-service stop $s; fi; done
  hs-service list > $T; box "Services" $T; }

# ---------------------------------------------------------------- logs
log_menu(){ while :; do
  c=$(ask D --title " Logs " --cancel-label "Back" --menu "What do you want to read?" 10 56 3 1 "System log" 2 "Kernel messages (dmesg)" 3 "Hardware summary") || return
  case $c in
  1) logread > $T 2>&1; box "System log" $T;;
  2) dmesg > $T 2>&1; box "Kernel messages" $T;;
  3) hs-sysinfo plain > $T; box "Hardware" $T;;
  esac; done; }

# ---------------------------------------------------------------- settings
set_menu(){ while :; do
  c=$(ask D --title " Settings " --cancel-label "Back" --menu "Change basic server settings." 11 62 4 \
    1 "Host name" 2 "Password (admin and root)" 3 "Time zone" 4 "Date and time") || return
  case $c in
  1) h=$(ask D --title " Host name " --inputbox "New host name:" 8 50 "$(hostname)") || continue
     if echo "$h" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,30}[A-Za-z0-9])?$'; then echo "$h" > $HS/hostname; hostname "$h"; msg "Host name" "Now called $h."; else msg "Host name" "Letters, digits and dashes only."; fi;;
  2) p1=$(ask D --insecure --title " Password " --passwordbox "New root password (min 6 characters):" 9 56) || continue
     p2=$(ask D --insecure --title " Password " --passwordbox "Repeat the password:" 9 56) || continue
     if [ "$p1" = "$p2" ] && [ ${#p1} -ge 6 ] && ! echo "$p1" | grep -q :; then printf 'root:%s\nadmin:%s\n' "$p1" "$p1" | chpasswd -c sha512; msg "Password" "Password of admin and root changed."
     else msg "Password" "Not changed: passwords differ, are shorter than 6 characters or contain a colon."; fi;;
  3) z=$(ask D --title " Time zone " --menu "Choose your time zone:" 20 62 13 \
       UTC "UTC" Kaliningrad "Kaliningrad (UTC+2)" Moscow "Moscow (UTC+3)" Samara "Samara (UTC+4)" Yekaterinburg "Yekaterinburg (UTC+5)" \
       CentralEurope "Central Europe" EasternEurope "Eastern Europe" UnitedKingdom "United Kingdom" \
       USEastern "US Eastern" USCentral "US Central" USPacific "US Pacific" India "India" China "China" Japan "Japan") || continue
     case $z in
       UTC) tz='UTC0';; Kaliningrad) tz='EET-2';; Moscow) tz='MSK-3';; Samara) tz='<+04>-4';; Yekaterinburg) tz='<+05>-5';;
       CentralEurope) tz='CET-1CEST,M3.5.0,M10.5.0/3';; EasternEurope) tz='EET-2EEST,M3.5.0/3,M10.5.0/4';; UnitedKingdom) tz='GMT0BST,M3.5.0/1,M10.5.0';;
       USEastern) tz='EST5EDT,M3.2.0,M11.1.0';; USCentral) tz='CST6CDT,M3.2.0,M11.1.0';; USPacific) tz='PST8PDT,M3.2.0,M11.1.0';;
       India) tz='IST-5:30';; China) tz='CST-8';; Japan) tz='JST-9';; *) tz='UTC0';;
     esac
     echo "$tz" > $HS/tz; TZ=$tz; export TZ; msg "Time zone" "Time zone set to $z. It applies fully after the next login.";;
  4) t=$(ask D --title " Date and time " --inputbox "Format: YYYY-MM-DD HH:MM:SS" 8 50 "$(date '+%Y-%m-%d %H:%M:%S')") || continue
     if date -s "$t" >/dev/null 2>&1; then [ -e /dev/rtc0 ] && hwclock -w -u 2>/dev/null; msg "Date and time" "Clock set to $(date)."; else msg "Date and time" "Could not parse \"$t\"."; fi;;
  esac; done; }

# ---------------------------------------------------------------- applications
apps_menu(){ while :; do
  c=$(ask D --title " Applications " --cancel-label "Back" --menu "Programs included in HomeServer OS." 17 72 9 \
    1 "Web browser (Lynx)" 2 "Text editor (vi)" 3 "File manager (nnn)" 4 "System monitor (btop)" \
    5 "Download a file (curl)" 6 "Disk partitioning (fdisk)" 7 "Calculator (bc)" 8 "Snake (game)" 9 "More programs (download)") || return
  case $c in
  1) hs-browser;;
  2) f=$(ask D --title " Text editor " --inputbox "File to edit (created if it does not exist):" 8 60 "/root/notes.txt") || continue; clear; vi "$f";;
  3) clear; nnn;;
  4) clear; btop;;
  5) u=$(ask D --title " Download " --inputbox "Address to download (https://...):" 8 64 "https://") || continue
     clear; (cd /root && curl -fLO --progress-bar "$u"); printf '\n Saved in /root. Press Enter.'; read -r _;;
  6) d=$(ask D --title " Partitioning " --inputbox "Disk to open in fdisk (for example /dev/sda).\nCareful: changes are written when you press w." 10 62 "/dev/") || continue; clear; fdisk "$d"; printf '\n Press Enter.'; read -r _;;
  8) clear; hs-snake;;
  9) hs-apps;;
  7) clear; printf ' bc calculator - type  quit  to leave. Example: 2^10 + 3*4\n\n'; bc -l 2>/dev/null || echo "bc is not available"; ;;
  esac; done; }

# ---------------------------------------------------------------- main
while :; do
  live=; [ -f $HS/live ] && live=1
  set -- 1 "System dashboard         live CPU, memory, network, processes" \
    2 "File manager             browse and manage files" \
    3 "Applications             web browser, editor, tools" \
    4 "Network                  address, status, connectivity test" \
    5 "Storage                  disks, USB drives, free space" \
    6 "Services                 web server, SSH, time sync, cron" \
    7 "SSH                      connect elsewhere, keys, server" \
    8 "Graphics and 3D          video drivers, OpenGL test" \
    9 "Logs                     system log and kernel messages" \
    S "Settings                 name, password, time zone, clock"
  [ -n "$live" ] && set -- "$@" I "\Zb\Z3Install to disk\Zn          put HomeServer OS on this computer"
  set -- "$@" X "Command-line shell       type  menu  to come back" P "Restart or power off"
  c=$(ask D --title " HomeServer OS " --cancel-label "Shell" --ok-label "Select" --menu "$(hs-status dialog)" 23 78 $(( $# / 2 )) "$@") || { clear; exit 0; }
  case $c in
  1) clear; btop;;
  2) clear; nnn;;
  3) apps_menu;;
  4) net_menu;;
  5) disk_menu;;
  6) svc_menu;;
  7) hs-ssh;;
  8) hs-gpu;;
  9) log_menu;;
  S) set_menu;;
  I) hs-install;;
  X) clear; hs-status ansi; printf '\n Type %smenu%s to return to the management menu, %sbtop%s for the dashboard.\n\n' "$(c '1;33')" "$(c 0)" "$(c '1;33')" "$(c 0)"; exit 0;;
  P) a=$(ask D --title " Power " --menu "What now?" 10 50 3 r "Restart" p "Power off" c "Cancel") || continue
     case $a in r) clear; reboot;; p) clear; poweroff;; esac;;
  esac
done
