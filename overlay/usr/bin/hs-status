#!/bin/sh
# usage: hs-status [dialog|plain|ansi]
. /usr/lib/hs/common.sh
host=$(hostname)
ip4=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | head -n1)
[ -n "$ip4" ] || ip4="no address"
up=$(awk '{s=int($1); printf "%dd %dh %dm", s/86400, s%86400/3600, s%3600/60}' /proc/uptime)
load=$(cut -d' ' -f1-3 /proc/loadavg)
mem=$(free -m | awk '/^Mem:/{printf "%d / %d MB", $3, $2}')
dsk=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s / %s (%s)", $3, $2, $5}'); [ -n "$dsk" ] || dsk="-"
kern=$(uname -r)
now=$(date '+%Y-%m-%d %H:%M')
case ${1:-plain} in
dialog)
  printf '\\Zb\\Z6Host\\Zn   %-16s \\Zb\\Z6Kernel\\Zn %s\\n' "$host" "$kern"
  printf '\\Zb\\Z6IP\\Zn     %-16s \\Zb\\Z6Uptime\\Zn %s\\n' "$ip4" "$up"
  printf '\\Zb\\Z6Load\\Zn   %-16s \\Zb\\Z6Time\\Zn   %s\\n' "$load" "$now"
  printf '\\Zb\\Z6Memory\\Zn %-16s \\Zb\\Z6Disk\\Zn   %s\\n' "$mem" "$dsk" ;;
ansi)
  printf ' %s%-8s%s %-18s %s%-8s%s %s\n' "$(c '1;36')" Host "$(c 0)" "$host" "$(c '1;36')" Kernel "$(c 0)" "$kern"
  printf ' %s%-8s%s %-18s %s%-8s%s %s\n' "$(c '1;36')" IP "$(c 0)" "$ip4" "$(c '1;36')" Uptime "$(c 0)" "$up"
  printf ' %s%-8s%s %-18s %s%-8s%s %s\n' "$(c '1;36')" Load "$(c 0)" "$load" "$(c '1;36')" Time "$(c 0)" "$now"
  printf ' %s%-8s%s %-18s %s%-8s%s %s\n' "$(c '1;36')" Memory "$(c 0)" "$mem" "$(c '1;36')" Disk "$(c 0)" "$dsk" ;;
*)
  printf 'Host:    %s\nKernel:  %s\nIP:      %s\nUptime:  %s\nLoad:    %s\nTime:    %s\nMemory:  %s\nDisk /:  %s\n' "$host" "$kern" "$ip4" "$up" "$load" "$now" "$mem" "$dsk" ;;
esac
