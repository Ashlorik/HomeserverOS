#!/bin/sh
. /usr/lib/hs/common.sh
printf '%s[2J%s[H' "$ESC" "$ESC"
cat /etc/hs/banner 2>/dev/null
printf '\n'
if [ -s $HS/hostname ]; then hostname "$(cat $HS/hostname)"; else hostname homesrv; fi
ok "Hostname set to $(hostname)"
ip link set lo up && ok "Loopback interface up"
mkdir -p /var/log /var/spool/cron/crontabs /run/hs
syslogd -C64 && klogd && ok "System logging started"
[ -e /dev/rtc0 ] && hwclock -s -u 2>/dev/null && ok "Clock set from hardware RTC"
hs-net apply >/dev/null 2>&1 &
ok "Network configuring in the background ($(. $HS/network.conf 2>/dev/null; echo "${MODE:-dhcp}"))"
hs-service autostart >/dev/null 2>&1
ok "Services: $(tr '\n' ' ' < $HS/services 2>/dev/null)"
[ -f $HS/configured ] || warn "First boot: the setup wizard starts on this screen"
printf '\n'
