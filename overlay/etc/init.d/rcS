#!/bin/sh
. /usr/lib/hs/common.sh
printf '%s[2J%s[H' "$ESC" "$ESC"
cat /etc/hs/banner 2>/dev/null
printf '\n'
step(){ ok "$*"; }
if [ -s $HS/hostname ]; then hostname "$(cat $HS/hostname)"; else hostname homesrv; fi
step "Hostname: $(hostname)"
ip link set lo up && step "Loopback interface up"
mkdir -p /var/log /var/spool/cron/crontabs /run/hs
syslogd -C64 && klogd && step "System logging started"
[ -e /dev/rtc0 ] && hwclock -s -u 2>/dev/null && step "Clock set from the hardware RTC"
# hardware: let the kernel modules that match the PCI/USB devices load (video drivers only when enabled)
[ -r $HS/gpu.conf ] && . $HS/gpu.conf
if [ "${GPU_AUTOLOAD:-off}" = on ]; then hs-gpu load >/dev/null 2>&1 & step "Video drivers: loading in the background"; fi
hs-net apply >/dev/null 2>&1 &
step "Network: configuring in the background ($(. $HS/network.conf 2>/dev/null; echo "${MODE:-dhcp}"))"
hs-service autostart >/dev/null 2>&1
step "Services: $(tr '\n' ' ' < $HS/services 2>/dev/null)"
command -v acpid >/dev/null 2>&1 && { acpid >/dev/null 2>&1 & }
[ -x /usr/bin/hs-power ] && hs-power apply >/dev/null 2>&1
printf '\n'; hs-sysinfo ansi; printf '\n'
[ -f $HS/live ] && warn "Live medium: choose Install on the next screen, or try the system first"
[ -f $HS/configured ] || warn "First boot: the setup wizard starts on this screen"
printf ' %sStartup took %s s.%s\n\n' "$(c '1;32')" "$(cut -d. -f1 /proc/uptime)" "$(c 0)"
# boot marker on the serial port (used by the CI smoke test; harmless without a UART)
[ -c /dev/ttyS0 ] && { echo "HOMESERVER-OS-BOOT-OK" >/dev/ttyS0; } 2>/dev/null &
